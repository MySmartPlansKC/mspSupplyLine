MARIA_DB_HOST=localhost
MARIA_DB_PORT=3306
MARIA_DB_USER=supplyline_app
MARIA_DB_PASSWORD=change_me
MARIA_DB_NAME=supplyLine_db
DB_POOL_LIMIT=10
PORT=3001
CORS_ORIGIN=http://localhost:5173

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# Dev seed (npm run seed:dev) — MspAdmin only; omit vars to use test defaults in seed script
# DEV_SEED_PASSWORD=SupplyLine123!
# DEV_MSPADMIN_EMAIL=mspadmin@supplyline.local
# Production example:
# DEV_MSPADMIN_EMAIL=steve.fisher@mysmartplans.com
# DEV_MSPADMIN_FIRST_NAME=Steve
# DEV_MSPADMIN_LAST_NAME=Fisher
# DEV_SEED_PASSWORD=

# SupplyLine AI tunnel (Pass 2 submittal line extraction)
MY_SMART_PLANS_AI_URL=
MY_SMART_PLANS_AI_KEY=

# Optional mspSaturn read pool (project registry hydration).
# On the same VM as MariaDB, omit SATURN_DB_HOST — it defaults to MARIA_DB_HOST.
# SATURN_DB_HOST=127.0.0.1
# SATURN_DB_USER=mspadmin
# SATURN_DB_PASSWORD=
# SATURN_DB_NAME=mspsaturn
# SATURN_DB_PORT=3306
