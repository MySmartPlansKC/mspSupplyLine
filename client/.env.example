# Optional: prefill login form in local dev only. Leave blank for production builds.
# Should match npm run seed:dev credentials (see server/.env.example DEV_* vars).
VITE_DEV_LOGIN_EMAIL=
VITE_DEV_LOGIN_PASSWORD=

# Optional API base when not using Vite proxy (default: same-origin /api)
# VITE_BASE_URL=

# Vite dev proxy target (must match server PORT in server/.env)
# VITE_API_PROXY_TARGET=http://localhost:3001
